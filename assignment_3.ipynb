    "    \"# Q5\\n\",\n",
    "    \"def compute_ppg_hr_metrics(ppg_df, sampling_rate=1000):\\n\",\n",
    "    \"    import neurokit2 as nk\\n\",\n",
    "    \"\\n\",\n",
    "    \"    ppg_signal = ppg_df['PPG'].fillna(method='ffill').fillna(method='bfill')\\n\",\n",
    "    \"    ppg_clean = nk.ppg_clean(ppg_signal, sampling_rate=sampling_rate)\\n\",\n",
    "    \"    _, peaks = nk.ppg_peaks(ppg_clean, sampling_rate=sampling_rate)\\n\",\n",
    "    \"    peak_indices = peaks['PPG_Peaks']\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Instantane Herzfrequenz\\n\",\n",
    "    \"    timestamps = ppg_df['timestamp'].values\\n\",\n",
    "    \"    rr_intervals = np.diff(timestamps[peak_indices]) / np.timedelta64(1, 's')\\n\",\n",
    "    \"    hr = 60 / rr_intervals\\n\",\n",
    "    \"    hr_time = timestamps[peak_indices][1:]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    inst_hr_df = pd.DataFrame({'timestamp': hr_time, 'hr': hr})\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Smoothed HR: Mean in 10s window, 1s slide\\n\",\n",
    "    \"    window_size = 10\\n\",\n",
    "    \"    step_size = 1\\n\",\n",
    "    \"    start_time = inst_hr_df['timestamp'].min() + timedelta(seconds=5)\\n\",\n",
    "    \"    end_time = inst_hr_df['timestamp'].max()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    smoothed_hr, times = [], []\\n\",\n",
    "    \"    current = start_time\\n\",\n",
    "    \"    while current + timedelta(seconds=window_size) < end_time:\\n\",\n",
    "    \"        window_end = current + timedelta(seconds=window_size)\\n\",\n",
    "    \"        middle = current + timedelta(seconds=window_size / 2)\\n\",\n",
    "    \"        hr_vals = inst_hr_df[(inst_hr_df['timestamp'] >= current) &\\n\",\n",
    "    \"                             (inst_hr_df['timestamp'] < window_end)]['hr']\\n\",\n",
    "    \"        if len(hr_vals) > 0:\\n\",\n",
    "    \"            smoothed_hr.append(np.mean(hr_vals))\\n\",\n",
    "    \"            times.append(middle)\\n\",\n",
    "    \"        current += timedelta(seconds=step_size)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    smoothed_df = pd.DataFrame({'timestamp': times, 'smoothed_hr': smoothed_hr})\\n\",\n",
    "    \"    return inst_hr_df, smoothed_df, ppg_df, peak_indices\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def plot_ppg_with_peaks(ppg_df, peak_indices, title, start_time, end_time):\\n\",\n",
    "    \"    segment = ppg_df[(ppg_df['timestamp'] >= start_time) & (ppg_df['timestamp'] <= end_time)]\\n\",\n",
    "    \"    segment_indices = segment.index\\n\",\n",
    "    \"    peaks_in_segment = [i for i in peak_indices if i in segment_indices]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.figure(figsize=(12, 4))\\n\",\n",
    "    \"    plt.plot(segment['timestamp'], segment['PPG'], label='PPG')\\n\",\n",
    "    \"    plt.plot(ppg_df['timestamp'].iloc[peaks_in_segment],\\n\",\n",
    "    \"             ppg_df['PPG'].iloc[peaks_in_segment], 'ro', label='Peaks')\\n\",\n",
    "    \"    plt.title(title)\\n\",\n",
    "    \"    plt.xlabel('Time')\\n\",\n",
    "    \"    plt.ylabel('PPG Amplitude')\\n\",\n",
    "    \"    plt.legend()\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def plot_ppg_hr(inst_hr_df, smoothed_hr_df, title):\\n\",\n",
    "    \"    plt.figure(figsize=(12, 4))\\n\",\n",
    "    \"    plt.plot(inst_hr_df['timestamp'], inst_hr_df['hr'], label='Instant HR', alpha=0.6)\\n\",\n",
    "    \"    plt.plot(smoothed_hr_df['timestamp'], smoothed_hr_df['smoothed_hr'],\\n\",\n",
    "    \"             label='Smoothed HR (10s mean)', linewidth=2)\\n\",\n",
    "    \"    plt.title(title)\\n\",\n",
    "    \"    plt.ylabel(\\\"Heart Rate (bpm)\\\")\\n\",\n",
    "    \"    plt.xlabel(\\\"Time\\\")\\n\",\n",
    "    \"    plt.legend()\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"\\n\"\n",
    "   ],\n",
