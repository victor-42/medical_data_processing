    "   \"source\": [\n",
    "    \"# Q3\\n\",\n",
    "    \"\\n\",\n",
    "    \"def compute_heart_rate_metrics(ecg_df, sampling_rate=1000):\\n\",\n",
    "    \"    # Schritt 1: R-Peak-Detection mit neurokit2\\n\",\n",
    "    \"    ecg_signal = ecg_df['ecg'].fillna(method='ffill').fillna(method='bfill')\\n\",\n",
    "    \"    ecg_cleaned = nk.ecg_clean(ecg_signal, sampling_rate=sampling_rate)\\n\",\n",
    "    \"    _, rpeaks = nk.ecg_peaks(ecg_cleaned, sampling_rate=sampling_rate)\\n\",\n",
    "    \"    rpeaks_indices = rpeaks['ECG_R_Peaks']\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Schritt 2: Instantane Herzfrequenz (ohne Toolbox)\\n\",\n",
    "    \"    rr_intervals = np.diff(ecg_df['timestamp'].values[rpeaks_indices]) / np.timedelta64(1, 's')\\n\",\n",
    "    \"    inst_hr = 60 / rr_intervals\\n\",\n",
    "    \"    inst_hr_time = ecg_df['timestamp'].values[rpeaks_indices][1:]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    inst_hr_df = pd.DataFrame({'timestamp': inst_hr_time, 'hr': inst_hr})\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Schritt 3: Geglättete HR (Median über 10s mit 1s Schrittweite)\\n\",\n",
    "    \"    window_size = 10\\n\",\n",
    "    \"    step_size = 1\\n\",\n",
    "    \"    start_time = inst_hr_df['timestamp'].min()\\n\",\n",
    "    \"    end_time = inst_hr_df['timestamp'].max()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    smoothed_hr = []\\n\",\n",
    "    \"    times = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    current = start_time\\n\",\n",
    "    \"    while current + timedelta(seconds=window_size) < end_time:\\n\",\n",
    "    \"        window_end = current + timedelta(seconds=window_size)\\n\",\n",
    "    \"        middle = current + timedelta(seconds=window_size / 2)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        hr_vals = inst_hr_df[(inst_hr_df['timestamp'] >= current) &\\n\",\n",
    "    \"                             (inst_hr_df['timestamp'] < window_end)]['hr']\\n\",\n",
    "    \"        if len(hr_vals) > 0:\\n\",\n",
    "    \"            smoothed_hr.append(np.median(hr_vals))\\n\",\n",
    "    \"            times.append(middle)\\n\",\n",
    "    \"        current += timedelta(seconds=step_size)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    smoothed_hr_df = pd.DataFrame({'timestamp': times, 'smoothed_hr': smoothed_hr})\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return inst_hr_df, smoothed_hr_df, ecg_df, rpeaks_indices\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def plot_ecg_with_rpeaks(ecg_df, rpeaks_indices, title, start_time, end_time):\\n\",\n",
    "    \"    segment = ecg_df[(ecg_df['timestamp'] >= start_time) & (ecg_df['timestamp'] <= end_time)].copy()\\n\",\n",
    "    \"    segment_indices = segment.index\\n\",\n",
    "    \"\\n\",\n",
    "    \"    rpeaks_in_segment = [i for i in rpeaks_indices if i in segment_indices]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.figure(figsize=(12, 4))\\n\",\n",
    "    \"    plt.plot(segment['timestamp'], segment['ecg'], label='ECG')\\n\",\n",
    "    \"    plt.plot(ecg_df['timestamp'].iloc[rpeaks_in_segment],\\n\",\n",
    "    \"             ecg_df['ecg'].iloc[rpeaks_in_segment], 'ro', label='R-peaks')\\n\",\n",
    "    \"    plt.title(title)\\n\",\n",
    "    \"    plt.xlabel('Time')\\n\",\n",
    "    \"    plt.ylabel('Amplitude')\\n\",\n",
    "    \"    plt.legend()\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def plot_hr(inst_hr_df, smoothed_hr_df, title):\\n\",\n",
    "    \"    plt.figure(figsize=(12, 4))\\n\",\n",
    "    \"    plt.plot(inst_hr_df['timestamp'], inst_hr_df['hr'], label='Instant HR', alpha=0.7)\\n\",\n",
    "    \"    plt.plot(smoothed_hr_df['timestamp'], smoothed_hr_df['smoothed_hr'], label='Smoothed HR', linewidth=2)\\n\",\n",
    "    \"    plt.title(title)\\n\",\n",
    "    \"    plt.ylabel('Heart Rate (bpm)')\\n\",\n",
    "    \"    plt.xlabel('Time')\\n\",\n",
    "    \"    plt.legend()\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    plt.show()\\n\"\n",
    "   ],\n",
