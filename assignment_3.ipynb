    "   \"source\": [\n",
    "    \"# Q7 Using Workout Data since it is more clear\\n\",\n",
    "    \"def butterworth_highpass_filter(signal, cutoff_freq, fs, order=2):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Simple implementation of a Butterworth high-pass filter using bilinear transform method.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    # Normalize frequency\\n\",\n",
    "    \"    wc = 2 * np.pi * cutoff_freq\\n\",\n",
    "    \"    T = 1 / fs\\n\",\n",
    "    \"    k = wc / np.tan(wc * T / 2)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Coefficients for second-order Butterworth HPF\\n\",\n",
    "    \"    a0 = k**2 + np.sqrt(2)*k + wc**2\\n\",\n",
    "    \"    a1 = 2 * (wc**2 - k**2)\\n\",\n",
    "    \"    a2 = k**2 - np.sqrt(2)*k + wc**2\\n\",\n",
    "    \"    b0 = k**2\\n\",\n",
    "    \"    b1 = -2 * k**2\\n\",\n",
    "    \"    b2 = k**2\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Normalize coefficients\\n\",\n",
    "    \"    b = np.array([b0, b1, b2]) / a0\\n\",\n",
    "    \"    a = np.array([1, a1/a0, a2/a0])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Apply filter (direct form II)\\n\",\n",
    "    \"    y = np.zeros_like(signal)\\n\",\n",
    "    \"    x = signal\\n\",\n",
    "    \"    for n in range(2, len(signal)):\\n\",\n",
    "    \"        y[n] = b[0]*x[n] + b[1]*x[n-1] + b[2]*x[n-2] - a[1]*y[n-1] - a[2]*y[n-2]\\n\",\n",
    "    \"    return y\\n\",\n",
    "    \"\\n\",\n",
    "    \"def detrend_signal(signal):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Simple linear detrending using numpy (alternative to scipy.signal.detrend).\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    x = np.arange(len(signal))\\n\",\n",
    "    \"    p = np.polyfit(x, signal, 1)\\n\",\n",
    "    \"    detrended = signal - np.polyval(p, x)\\n\",\n",
    "    \"    return detrended\\n\",\n",
    "    \"\\n\",\n",
    "    \"def get_heart_rate_from_fft(window, fs):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Given a 10s window of PPG data, extract heart rate from FFT peak.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    # Step 1: Preprocess - Detrend and High-pass Filter\\n\",\n",
    "    \"    detrended = detrend_signal(window)\\n\",\n",
    "    \"    filtered = butterworth_highpass_filter(detrended, cutoff_freq=0.5, fs=fs, order=2)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Step 2: FFT\\n\",\n",
    "    \"    n = len(filtered)\\n\",\n",
    "    \"    freqs = np.fft.rfftfreq(n, d=1/fs)\\n\",\n",
    "    \"    fft_magnitude = np.abs(np.fft.rfft(filtered))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Step 3: Limit search to typical heart rate band (0.7Hz to 3Hz) -> 42bpm to 180bpm\\n\",\n",
    "    \"    hr_band = (freqs >= 0.7) & (freqs <= 3.0)\\n\",\n",
    "    \"    target_freqs = freqs[hr_band]\\n\",\n",
    "    \"    target_magnitudes = fft_magnitude[hr_band]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Step 4: Find dominant frequency in HR band\\n\",\n",
    "    \"    if len(target_magnitudes) > 0:\\n\",\n",
    "    \"        peak_index = np.argmax(target_magnitudes)\\n\",\n",
    "    \"        dominant_freq = target_freqs[peak_index]\\n\",\n",
    "    \"        heart_rate_bpm = dominant_freq * 60  # Convert Hz to bpm\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        heart_rate_bpm = np.nan  # No valid peak detected\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return heart_rate_bpm\\n\",\n",
    "    \"\\n\",\n",
    "    \"def sliding_window_heart_rate(ppg_signal, fs):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Apply 10s sliding window over PPG signal and extract HR per second (from 5s onwards).\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    window_size = 10 * fs\\n\",\n",
    "    \"    step_size = fs  # 1-second step for sliding window\\n\",\n",
    "    \"    hr_estimates = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for start in range(0, len(ppg_signal) - window_size + 1, step_size):\\n\",\n",
    "    \"        window = ppg_signal[start:start + window_size]\\n\",\n",
    "    \"        hr = get_heart_rate_from_fft(window, fs)\\n\",\n",
    "    \"        hr_estimates.append(hr)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return np.array(hr_estimates)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"watch_workout_res_df = crop_window(watch_workout_resampled, start_time=datetime(2025, 6, 12, 10, 42, 47, 0),\\n\",\n",
    "    \"                                   end_time=datetime(2025, 6, 12, 11, 43, 00, 0),)\\n\",\n",
    "    \"\\n\",\n",
    "    \"heart_rates = sliding_window_heart_rate(watch_workout_res_df['PPG'].to_numpy(), fs=1000)\\n\",\n",
    "    \"times = np.arange(5, 5 + len(heart_rates))  # Heart rate time stamps starting at 5s\\n\",\n",
    "    \"heart_rates\"\n",
    "   ],\n",
