    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# Q8\\n\",\n",
    "    \"\\n\",\n",
    "    \"def crop_window(data, start_time, end_time):\\n\",\n",
    "    \"    data = data[(data['timestamp'] >= start_time) & (data['timestamp'] <= end_time)]\\n\",\n",
    "    \"    return data\\n\",\n",
    "    \"\\n\",\n",
    "    \"def calculate_hr_per_second(heart_rates_set):\\n\",\n",
    "    \"    # attempts to get sets to equal length by taking one sample per second. does not, in fact, get the sets to equal length for reasons unknown\\n\",\n",
    "    \"    heart_rates_per_second = []\\n\",\n",
    "    \"    seconds = []\\n\",\n",
    "    \"    current_sum = 0\\n\",\n",
    "    \"    current_counter = 0\\n\",\n",
    "    \"    current_time = 0\\n\",\n",
    "    \"    for index, row in heart_rates_set.iterrows():\\n\",\n",
    "    \"        timestamp = row['timestamp'].timestamp()\\n\",\n",
    "    \"        heart_rate = row['hr']\\n\",\n",
    "    \"        if current_time == 0:\\n\",\n",
    "    \"            current_time = timestamp\\n\",\n",
    "    \"        elif timestamp - current_time > 1:\\n\",\n",
    "    \"            heart_rates_per_second.append(current_sum/current_counter)\\n\",\n",
    "    \"            seconds.append(current_time)\\n\",\n",
    "    \"            current_time += 1\\n\",\n",
    "    \"            current_counter = 0\\n\",\n",
    "    \"            current_sum = 0\\n\",\n",
    "    \"\\n\",\n",
    "    \"        current_counter += 1\\n\",\n",
    "    \"        current_sum += heart_rate\\n\",\n",
    "    \"    return pd.DataFrame({'seconds': seconds, 'hr': heart_rates_per_second})\\n\",\n",
    "    \"\\n\",\n",
    "    \"def calculate_mae(data, gt_key, p_key):\\n\",\n",
    "    \"    mae = np.mean(np.abs(np.subtract(data[gt_key], data[p_key])))\\n\",\n",
    "    \"    return mae\\n\",\n",
    "    \"\\n\"\n",
    "   ],\n",
