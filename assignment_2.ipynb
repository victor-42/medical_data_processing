    "    \"bp_noisy = load_bp_csv('data/assignment_2/recording_2_ecgppg_biopac_noisy.txt',\\n\",\n",
    "    \"                        start_datetime=datetime(2025, 5, 22, 9, 54, 40, 285000) - timedelta(seconds=0.4))\\n\",\n",
    "    \"watch_clean = load_watch_data('data/assignment_2/recording_1_ecg_watch_clean_data.csv',\\n\",\n",
    "    \"                              'data/assignment_2/recording_1_ppg_watch_clean_data.csv')\\n\",\n",
    "    \"watch_noisy = load_watch_data('data/assignment_2/recording_2_ecg_watch_noisy.csv',\\n\",\n",
    "    \"                              'data/assignment_2/recording_2_ppg_watch_noisy.csv')\\n\",\n",
