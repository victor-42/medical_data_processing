    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": [\n",
    "    \"# Time domain\\n\",\n",
    "    \"Consider an ECG signal, using fixed windows of 5s with 50% overlap, compute the following features for a segment of 30s long:\\n\",\n",
    "    \"- Mean\\n\",\n",
    "    \"- Median\\n\",\n",
    "    \"- Variance\\n\",\n",
    "    \"- Std Dev\\n\",\n",
    "    \"- Skewness\\n\",\n",
    "    \"- RMS\\n\",\n",
    "    \"- Zero-Crossing Rate\\n\",\n",
    "    \"- Energy\\n\",\n",
    "    \"- Power\\n\",\n",
    "    \"\\n\",\n",
    "    \"Apply this porcedure to the ECG signals acquired from ADI Study Watch and BioNomadix.\"\n",
    "   ],\n",
    "   \"id\": \"b00c697e\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-06-04T12:54:13.607284Z\",\n",
    "     \"start_time\": \"2025-06-04T12:54:09.053249Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
