    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# Frequency domain analysis\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"11bdd9b5\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-06-05T14:33:22.272503Z\",\n",
    "     \"start_time\": \"2025-06-05T14:33:22.268190Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# Q2\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 11\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"498f290e\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# Frequency domain \\n\",\n",
    "    \"From the same ECG signals of the previous item, compute the Discrete Fourier Transform and the power spectral density using the functions of periodogram and welch of the scipy.signal library.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"7409ce8b\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-06-05T14:33:22.749002Z\",\n",
    "     \"start_time\": \"2025-06-05T14:33:22.745514Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# Q3\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 12\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"1aab90b1\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# Time-frequency domain\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"bb6a4eac\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-06-05T15:04:26.909222Z\",\n",
    "     \"start_time\": \"2025-06-05T15:04:26.342904Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# Q4 TODO: Noch Falsch, ich bin mir nicht sicher ob ich hier schon stft verwenden soll oder nicht\\n\",\n",
    "    \"\\n\",\n",
    "    \"def generate_stationary_signals(fs, duration, frequencies):\\n\",\n",
    "    \"    t = np.linspace(0, duration, int(fs * duration), endpoint=False)\\n\",\n",
    "    \"    return [np.sin(2 * np.pi * freq * t) for freq in frequencies]\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def generate_composite_signal(fs, duration, frequencies):\\n\",\n",
    "    \"    signal_comp = np.sum(np.stack(generate_stationary_signals(fs, duration, frequencies)), axis=0)\\n\",\n",
    "    \"    return signal_comp\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def generate_non_stationary_signals(fs,  # Sampling frequency (Hz)\\n\",\n",
    "    \"                                    frequencies,  # Frequencies to generate\\n\",\n",
    "    \"                                    cycles):\\n\",\n",
    "    \"    # Calculate durations and create time array\\n\",\n",
    "    \"    segment_durations = [c / f for c, f in zip(cycles, frequencies)]\\n\",\n",
    "    \"    total_duration = sum(segment_durations)\\n\",\n",
    "    \"    t = np.linspace(0, total_duration, int(fs * total_duration), endpoint=False)\\n\",\n",
    "    \"    signal_non_st = np.zeros(len(t))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Generate a Non-Stationary signal \\n\",\n",
    "    \"    current_sample = 0\\n\",\n",
    "    \"    for freq, n_cycles in zip(frequencies, cycles):\\n\",\n",
    "    \"        seg_samples = int(n_cycles / freq * fs)\\n\",\n",
    "    \"        local_t = np.arange(seg_samples) / fs\\n\",\n",
    "    \"        segment = np.sin(2 * np.pi * freq * local_t)\\n\",\n",
    "    \"        signal_non_st[current_sample:current_sample + seg_samples] = segment\\n\",\n",
    "    \"        current_sample += seg_samples\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Create reversed signal\\n\",\n",
    "    \"    reversed_signal_non_st = signal_non_st[::-1]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return signal_non_st, reversed_signal_non_st\\n\",\n",
    "    \"\\n\",\n",
    "    \"fs=500  # Sampling frequency (Hz)\\n\",\n",
    "    \"\\n\",\n",
    "    \"stationary_signals = generate_stationary_signals(fs=500, duration=1, frequencies=[10, 25, 50, 100])\\n\",\n",
    "    \"comp_signal = generate_composite_signal(fs=500, duration=1, frequencies=[10, 25, 50, 100])\\n\",\n",
    "    \"signal_non_st, reversed_signal_non_st = generate_non_stationary_signals(fs=500,  # Sampling frequency (Hz)\\n\",\n",
    "    \"                                                                        frequencies=[10, 25, 50, 100],\\n\",\n",
    "    \"                                                                        # Frequencies to generate\\n\",\n",
    "    \"                                                                        cycles=[3, 6, 12, 25])\\n\",\n",
    "    \"signals = {\\n\",\n",
    "    \"    'composite_st_signal': comp_signal,\\n\",\n",
    "    \"    'signal_non_st': signal_non_st,\\n\",\n",
    "    \"    'reversed_signal_non_st': reversed_signal_non_st\\n\",\n",
    "    \"}\\n\",\n",
    "    \"for name, signal in signals.items():\\n\",\n",
    "    \"    plt.figure(figsize=(10, 4))\\n\",\n",
    "    \"    plt.plot(signal)\\n\",\n",
    "    \"    plt.title(f'{name} - Time Domain Signal')\\n\",\n",
    "    \"    plt.xlabel('Sample Index')\\n\",\n",
    "    \"    plt.ylabel('Amplitude')\\n\",\n",
    "    \"    plt.grid()\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    window_size = 128\\n\",\n",
    "    \"    hop_size = 128\\n\",\n",
    "    \"    nfft = 512  # FFT size\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Hann window\\n\",\n",
    "    \"    window = np.hanning(window_size)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Calculate number of frames\\n\",\n",
    "    \"    num_frames = (len(signal) - window_size) // hop_size + 1\\n\",\n",
    "    \"    spectrogram = np.zeros((nfft // 2, num_frames))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Compute STFT manually\\n\",\n",
    "    \"    for i in range(num_frames):\\n\",\n",
    "    \"        start = i * hop_size\\n\",\n",
    "    \"        segment = signal[start:start + window_size] * window\\n\",\n",
    "    \"        spectrum = np.fft.fft(segment, n=nfft)[:nfft // 2]\\n\",\n",
    "    \"        spectrogram[:, i] = np.abs(spectrum)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Time and frequency axes\\n\",\n",
    "    \"    time = np.arange(num_frames) * hop_size / fs\\n\",\n",
    "    \"    freq = np.fft.fftfreq(nfft, d=1/fs)[:nfft // 2]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.figure(figsize=(10, 6))\\n\",\n",
    "    \"    plt.imshow(20 * np.log10(spectrogram + 1e-6), aspect='auto', origin='lower',\\n\",\n",
    "    \"               extent=[time[0], time[-1], freq[0], freq[-1]], cmap='jet')\\n\",\n",
    "    \"    plt.colorbar(label='Magnitude (dB)')\\n\",\n",
    "    \"    plt.title(name + ' - STFT Magnitude')\\n\",\n",
    "    \"    plt.xlabel('Time [s]')\\n\",\n",
    "    \"    plt.ylabel('Frequency [Hz]')\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"\\n\"\n",
    "   ],\n",
