    "   \"source\": [\n",
    "    \"#calculate measurements from watch and bp data\\n\",\n",
    "    \"\\n\",\n",
    "    \"def plot_data_descriptions(watch_df, bp_df, dataset_name='Give Name Please'):\\n\",\n",
    "    \"    description_df.loc[len(description_df)] = [\\n\",\n",
    "    \"        dataset_name + ' Watch',\\n\",\n",
    "    \"        watch_df['ecg'].mean(),\\n\",\n",
    "    \"        watch_df['ecg'].median(),\\n\",\n",
    "    \"        watch_df['ecg'].var(),\\n\",\n",
    "    \"        watch_df['ecg'].std(),\\n\",\n",
    "    \"        watch_df['ecg'].skew(),\\n\",\n",
    "    \"        np.sqrt(np.mean(watch_df['ecg'] ** 2)),\\n\",\n",
    "    \"        np.mean(np.diff(np.sign(watch_df['ecg'])) != 0),\\n\",\n",
    "    \"        np.sum(watch_df['ecg'] ** 2),\\n\",\n",
    "    \"        np.mean(watch_df['ecg'] ** 2)\\n\",\n",
    "    \"    ]\\n\",\n",
    "    \"    description_df.loc[len(description_df)] = [\\n\",\n",
    "    \"        dataset_name + ' BP',\\n\",\n",
    "    \"        bp_df['ecg'].mean(),\\n\",\n",
    "    \"        bp_df['ecg'].median(),\\n\",\n",
    "    \"        bp_df['ecg'].var(),\\n\",\n",
    "    \"        bp_df['ecg'].std(),\\n\",\n",
    "    \"        bp_df['ecg'].skew(),\\n\",\n",
    "    \"        np.sqrt(np.mean(bp_df['ecg'] ** 2)),\\n\",\n",
    "    \"        np.mean(np.diff(np.sign(bp_df['ecg'])) != 0),\\n\",\n",
    "    \"        np.sum(bp_df['ecg'] ** 2),\\n\",\n",
    "    \"        np.mean(bp_df['ecg'] ** 2)\\n\",\n",
    "    \"    ]\"\n",
    "   ],\n",
