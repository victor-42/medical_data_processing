    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"7ec912da\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# Reading and plotting signals\\n\",\n",
    "    \"Read recorded signals from ADI Study Watch and BioNomadix devices. \\n\",\n",
    "    \"Plot ECG, PPG, and accelerometer data from the smartwatch, and ECG from BioNomadix.\\n\",\n",
    "    \"Signals must be plotted with x-axis in time, in seconds.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-06-05T15:03:51.827552Z\",\n",
    "     \"start_time\": \"2025-06-05T15:03:51.822768Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"from datetime import datetime\\n\",\n",
    "    \"\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import scipy\\n\",\n",
    "    \"from datetime import timedelta\\n\",\n",
    "    \"import pywt\\n\",\n",
    "    \"\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Import Pandas only for reading Watch CSV File and for plotting description in Q1\\n\",\n",
    "    \"import pandas as pd\\n\"\n",
    "   ],\n",
    "   \"id\": \"b3e194d6f0215128\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 1\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"6e3cfc9e\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# Time domain analysis\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-06-04T14:36:28.621651Z\",\n",
    "     \"start_time\": \"2025-06-04T14:36:28.602772Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def load_bp_csv(filename, start_datetime):\\n\",\n",
    "    \"    test = pd.read_csv(filename, skiprows=8, header=1, delimiter='\\\\t')\\n\",\n",
    "    \"    test = test.drop(0)\\n\",\n",
    "    \"    test = test.drop(test.columns[3], axis=1)  # Drop the first column\\n\",\n",
    "    \"    test = test.rename(columns={'milliSec': 'time_ms', 'CH13': 'ecg', 'CH1': 'ppg'})\\n\",\n",
    "    \"    test['ecg'] = pd.to_numeric(test['ecg'], errors='coerce')\\n\",\n",
    "    \"    test['timestamp'] = pd.to_datetime(start_datetime) + pd.to_timedelta(test['time_ms'], unit='ms')\\n\",\n",
    "    \"    return test\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def load_watch_ecg(filename):\\n\",\n",
    "    \"    df = pd.read_csv(filename, skiprows=2)\\n\",\n",
    "    \"    df = df[['Timestamp', 'ECG data']].dropna()\\n\",\n",
    "    \"    df.rename(columns={'Timestamp': 'timestamp', 'ECG data': 'ecg'}, inplace=True)\\n\",\n",
    "    \"    df['timestamp'] = pd.to_numeric(df['timestamp'], errors='coerce')\\n\",\n",
    "    \"    df['ecg'] = pd.to_numeric(df['ecg'], errors='coerce')\\n\",\n",
    "    \"    df = df.dropna()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Convert to seconds\\n\",\n",
    "    \"    df['time_ms'] = (df['timestamp'] - df['timestamp'].iloc[0])\\n\",\n",
    "    \"    return df\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def load_watch_data(ecg_file, ppg_file):\\n\",\n",
    "    \"    ecg_df = pd.read_csv(ecg_file, skiprows=2)\\n\",\n",
    "    \"    ppg_df = pd.read_csv(ppg_file, skiprows=2)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Rename columns for clarity\\n\",\n",
    "    \"    ecg_df.rename(columns={'Timestamp': 'timestamp', 'ECG data': 'ecg'}, inplace=True)\\n\",\n",
    "    \"    ppg_df.rename(columns={'PPG Timestamp': 'timestamp', 'PPG data': 'ppg'}, inplace=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Add column with time in milli seconds\\n\",\n",
    "    \"    ecg_df['time_ms'] = (ecg_df['timestamp'] - ecg_df['timestamp'].iloc[0])\\n\",\n",
    "    \"    ppg_df['time_ms'] = (ppg_df['timestamp'] - ppg_df['timestamp'].iloc[0])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    latest_start_time = max(ecg_df['timestamp'].iloc[0], ppg_df['timestamp'].iloc[0])\\n\",\n",
    "    \"    earliest_end_time = min(ecg_df['timestamp'].iloc[-1], ppg_df['timestamp'].iloc[-1])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Filter data to the common time range\\n\",\n",
    "    \"    ecg_df = ecg_df[(ecg_df['timestamp'] >= latest_start_time) & (ecg_df['timestamp'] <= earliest_end_time)]\\n\",\n",
    "    \"    ppg_df = ppg_df[(ppg_df['timestamp'] >= latest_start_time) & (ppg_df['timestamp'] <= earliest_end_time)]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Drop all columns except timestamp, time_ms and ecg/ppg\\n\",\n",
    "    \"    ppg_df = ppg_df.drop(columns=['ADXL Timestamp', 'X', 'Y', 'Z'])\\n\",\n",
    "    \"    ecg_df = ecg_df.drop(columns=['Seq No.'])\\n\",\n",
    "    \"    # Merge ECG and PPG based on the millisecond given\\n\",\n",
    "    \"    merged_df = pd.merge_asof(ecg_df.sort_values('timestamp'), ppg_df.sort_values('timestamp'), on='timestamp',\\n\",\n",
    "    \"                              direction='nearest')\\n\",\n",
    "    \"\\n\",\n",
    "    \"    merged_df['timestamp'] = pd.to_datetime(merged_df['timestamp'], unit='ms')\\n\",\n",
    "    \"    return merged_df\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def plot_watch_bp_ecg(watch_df, bp_data, start_time, end_time):\\n\",\n",
    "    \"    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(12, 8), sharex=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    watch_df.sort_values('time_ms_x', inplace=True)\\n\",\n",
    "    \"    bp_data.sort_values('time_ms', inplace=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Select time frame to plot\\n\",\n",
    "    \"    # Discard time frames that are not represented in both recordings\\n\",\n",
    "    \"    latest_start_time = max(watch_df['timestamp'].iloc[0], bp_data['timestamp'].iloc[0]) # + timedelta(minutes=5)\\n\",\n",
    "    \"    earliest_end_time = min(watch_df['timestamp'].iloc[-1], bp_data['timestamp'].iloc[-1])\\n\",\n",
    "    \"    watch_df = watch_df[(watch_df['timestamp'] >= latest_start_time) & (watch_df['timestamp'] <= earliest_end_time)]\\n\",\n",
    "    \"    watch_df = watch_df[(watch_df['timestamp'] >= start_time) & (watch_df['timestamp'] <= end_time)]\\n\",\n",
    "    \"    bp_data = bp_data[(bp_data['timestamp'] >= latest_start_time) & (bp_data['timestamp'] <= earliest_end_time)]\\n\",\n",
    "    \"    bp_data = bp_data[(bp_data['timestamp'] >= start_time) & (bp_data['timestamp'] <= end_time)]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Plot ECG from Watch\\n\",\n",
    "    \"    ax1.plot(watch_df['timestamp'], watch_df['ecg'], label='ECG from Watch', color='blue')\\n\",\n",
    "    \"    ax1.set_ylabel('ECG Amplitude')\\n\",\n",
    "    \"    ax1.set_xlabel('Time')\\n\",\n",
    "    \"    ax1.set_title('ECG Signal from Smartwatch')\\n\",\n",
    "    \"    ax1.legend()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Plot ECG from BioPac\\n\",\n",
    "    \"    ax2.plot(bp_data['timestamp'], bp_data['ecg'], label='ECG from BioPac', color='orange')\\n\",\n",
    "    \"    ax2.set_xlabel('Time (s)')\\n\",\n",
    "    \"    ax2.set_ylabel('ECG Amplitude')\\n\",\n",
    "    \"    ax2.set_title('ECG Signal from BioPac')\\n\",\n",
    "    \"    ax2.legend()\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"def crop_window(data, start_time, end_time):\\n\",\n",
    "    \"    data = data[(data['timestamp'] >= start_time) & (data['timestamp'] <= end_time)]\\n\",\n",
    "    \"    return data\\n\"\n",
    "   ],\n",
